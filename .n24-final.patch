@@ -0,0 +1,97 @@
+const fs = require('fs');
+const vm = require('vm');
+const assert = require('assert');
+
+const src = fs.readFileSync(require('path').join(__dirname, '..', 'script.js'), 'utf8');
+
+function extractFunction(name) {
+  const start = src.indexOf('function ' + name + '(');
+  if (start < 0) throw new Error('missing function ' + name);
+  let brace = src.indexOf('{', start), depth = 0;
+  for (let i = brace; i < src.length; i++) {
+    if (src[i] === '{') depth++;
+    else if (src[i] === '}') {
+      depth--;
+      if (depth === 0) return src.slice(start, i + 1);
+    }
+  }
+  throw new Error('unterminated function ' + name);
+}
+
+let checks = 0;
+function ok(cond, msg) { checks++; assert.ok(cond, msg); }
+
+async function runCase(resultOrError) {
+  const logs = [];
+  const ctx = {
+    selectedFrom: { row: 1, col: 2 },
+    updateSelectionDomCalls: 0,
+    updateSelectionDom() { this.updateSelectionDomCalls++; },
+    applyHumanMoveViaSession() {
+      if (resultOrError instanceof Error) return Promise.reject(resultOrError);
+      return Promise.resolve(resultOrError);
+    },
+    Promise,
+    console: { error(...args) { logs.push(args); } }
+  };
+  vm.createContext(ctx);
+  vm.runInContext(extractFunction('attemptOwnerHumanMove'), ctx);
+  let unhandled = null;
+  const onUnhandled = err => { unhandled = err; };
+  process.once('unhandledRejection', onUnhandled);
+  ctx.attemptOwnerHumanMove(1,2,3,4);
+  await new Promise(r => setImmediate(r));
+  process.removeListener('unhandledRejection', onUnhandled);
+  return { ctx, logs, unhandled };
+}
+
+(async () => {
+  const err = new Error('network down');
+  let r = await runCase(err);
+  ok(r.unhandled === null, 'reject is handled (no unhandledRejection)');
+  ok(r.logs.length === 1, 'reject is logged exactly once');
+  ok(r.logs[0][0] === 'Synced bot human move failed', 'reject uses expected log label');
+  ok(r.ctx.selectedFrom === null, 'reject clears selectedFrom');
+  ok(r.ctx.updateSelectionDomCalls === 1, 'reject updates selection DOM');
+
+  r = await runCase({ committed: false });
+  ok(r.unhandled === null, 'committed:false is not an error');
+  ok(r.logs.length === 0, 'committed:false does not hit catch/log');
+  ok(r.ctx.selectedFrom && r.ctx.selectedFrom.row === 1, 'committed:false preserves selection');
+  ok(r.ctx.updateSelectionDomCalls === 0, 'committed:false leaves DOM selection unchanged');
+
+  r = await runCase({ committed: true });
+  ok(r.unhandled === null, 'success remains handled');
+  ok(r.logs.length === 0, 'success has no error log');
+  ok(r.ctx.selectedFrom === null, 'success clears selection as before');
+  ok(r.ctx.updateSelectionDomCalls === 1, 'success updates selection DOM as before');
+
+  console.log(`owner-human-move-error-handling: ${checks}/${checks}`);
+})().catch(err => { console.error(err); process.exit(1); });
+
