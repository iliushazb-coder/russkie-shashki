+const fs = require('fs');
+const vm = require('vm');
+const assert = require('assert');
+
+const src = fs.readFileSync(require('path').join(__dirname, '..', 'script.js'), 'utf8');
+
+function extractFunction(name) {
+  const start = src.indexOf('function ' + name + '(');
+  if (start < 0) throw new Error('missing function ' + name);
+  let brace = src.indexOf('{', start), depth = 0;
+  for (let i = brace; i < src.length; i++) {
+    if (src[i] === '{') depth++;
+    else if (src[i] === '}') { depth--; if (depth === 0) return src.slice(start, i + 1); }
+  }
+  throw new Error('unterminated function ' + name);
+}
+
+function baseContext(database) {
+  const ctx = {
+    database,
+    myPendingOnlineRoom: null, myPendingFriendRoomCode: null,
+    roomCode: null, myColor: null, isOnlineGame: false, isSpectator: false,
+    myTelegramId: 'tg_1', myTelegramName: 'Me', GROUP_ID: 'g', pendingTimeControlSeconds: 0,
+    currentState: null, activeMatchRef: null,
+    firebase: { database: { ServerValue: { TIMESTAMP: 1 } } },
+    canUseFirebase: () => true,
+    generateRoomCode: () => 'ABC123',
+    createInitialPieces: () => ({}), getDrawPositionKey: () => 'p',
+    setupPresence() {}, detachRoomListener() {}, stopPresenceHeartbeat() {},
+    showGroupLobbyCalls: 0, showGroupLobby() { this.showGroupLobbyCalls++; },
+    showInfoModalCalls: [], showInfoModal(msg) { this.showInfoModalCalls.push(msg); },
+    showScreenCalls: [], showScreen(screen) { this.showScreenCalls.push(screen); },
+    startOnlineGameCalls: 0, startOnlineGame() { this.startOnlineGameCalls++; },
+    updateSelectionDom() {},
+    waitingScreen: {}, menuScreen: {}, gameScreen: {},
+    inviteLinkBox: { textContent:'', classList:{ remove(){} } },
+    waitingText: { textContent:'' }, btnShareLink:{ classList:{ remove(){} } },
+    BOT_USERNAME:'bot',
+    t: key => key,
+    workerErrorCode: e => (e && (e.code || e.message)) || 'error',
+    setTimeout(fn) { fn(); return 1; }, clearTimeout() {},
+    Promise, console
+  };
+  ctx.withBoundedRetry = function(operation) {
+    const delays = [0, 1, 2];
+    function attempt(i) {
+      let p;
+      try { p = Promise.resolve(operation()); } catch (e) { p = Promise.reject(e); }
+      return p.catch(err => { if (i + 1 < delays.length) return attempt(i + 1); throw err; });
+    }
+    return attempt(0);
+  };
+  return ctx;
+}
+
+function makeDatabase({ roomSetReject=false, friendSetReject=false, preflightReject=false }={}) {
+  const listeners = {};
+  const calls = [];
+  return {
+    _listeners:listeners, _calls:calls,
+    _fire(path, value) { const cb = listeners[path]; if (cb) cb({val:()=>value}); },
+    ref(path) {
+      return {
+        set(value) {
+          calls.push(['set', path, value]);
+          if (path === 'rooms/ABC123' && roomSetReject) return Promise.reject(new Error('room reject'));
+          if (path === 'rooms/ABC123' && friendSetReject) return Promise.reject(new Error('friend reject'));
+          return Promise.resolve();
+        },
+        remove() {
+          calls.push(['remove', path]);
+          if (path === 'users/tg_1/activeMatch' && preflightReject) return Promise.reject(new Error('preflight reject'));
+          return Promise.resolve();
+        },
+        on(evt, cb) { listeners[path]=cb; },
+        off() { delete listeners[path]; }
+      };
+    }
+  };
+}
+
+function loadFunctions(ctx) {
+  vm.createContext(ctx);
+  vm.runInContext(extractFunction('createOnlineRoom'), ctx);
+  vm.runInContext(extractFunction('createRoomAndShowWaiting'), ctx);
+}
+
+async function tick() { await new Promise(r => setImmediate(r)); }
+let checks=0; function ok(v,m){checks++;assert.ok(v,m);}
+
+(async()=>{
+  // 1) createOnlineRoom room-set reject -> USER ERROR + rollback.
+  let db=makeDatabase({roomSetReject:true}), ctx=baseContext(db); loadFunctions(ctx);
+  ctx.createOnlineRoom(); await tick();
+  ok(ctx.roomCode===null,'online reject clears roomCode');
+  ok(ctx.myColor===null,'online reject clears myColor');
+  ok(ctx.isOnlineGame===false,'online reject clears isOnlineGame');
+  ok(ctx.isSpectator===false,'online reject clears isSpectator');
+  ok(ctx.showInfoModalCalls.includes('err_room_create_failed'),'online reject shows USER ERROR');
+  ok(ctx.showGroupLobbyCalls===0,'online reject does not run success flow');
+
+  // 2) friend-room set reject -> USER ERROR + full rollback.
+  db=makeDatabase({friendSetReject:true}); ctx=baseContext(db); loadFunctions(ctx);
+  ctx.createRoomAndShowWaiting(); await tick();
+  ok(ctx.roomCode===null,'friend reject clears roomCode');
+  ok(ctx.myPendingFriendRoomCode===null,'friend reject clears pending friend code');
+  ok(ctx.myColor===null,'friend reject clears myColor');
+  ok(ctx.isOnlineGame===false,'friend reject clears isOnlineGame');
+  ok(ctx.isSpectator===false,'friend reject clears isSpectator');
+  ok(ctx.showInfoModalCalls.includes('err_room_create_failed'),'friend reject shows USER ERROR');
+
+  // 3) success paths keep state and enter normal callbacks.
+  db=makeDatabase(); ctx=baseContext(db); loadFunctions(ctx); ctx.createOnlineRoom(); await tick();
+  ok(ctx.roomCode==='ABC123','online success keeps roomCode');
+  ok(ctx.isOnlineGame===true,'online success keeps online state');
+  ok(ctx.showGroupLobbyCalls===1,'online success reaches lobby');
+  db=makeDatabase(); ctx=baseContext(db); loadFunctions(ctx); ctx.createRoomAndShowWaiting(); await tick();
+  ok(ctx.roomCode==='ABC123','friend success keeps roomCode');
+  ok(ctx.isOnlineGame===true,'friend success keeps online state');
+  ok(ctx.showScreenCalls.includes(ctx.waitingScreen),'friend success reaches waiting screen');
+
+  // 4) auth loss after room-set reject: rollback must still happen; modal may be skipped.
+  db=makeDatabase({roomSetReject:true}); ctx=baseContext(db);
+  let canCalls=0; ctx.canUseFirebase=()=>{canCalls++; return canCalls<3;}; loadFunctions(ctx);
+  ctx.createOnlineRoom(); await tick();
+  ok(ctx.roomCode===null,'auth-loss catch still clears roomCode');
+  ok(ctx.isOnlineGame===false,'auth-loss catch still clears isOnlineGame');
+
+  // 5) friend auth loss during catch still rolls back.
+  db=makeDatabase({friendSetReject:true}); ctx=baseContext(db);
+  canCalls=0; ctx.canUseFirebase=()=>{canCalls++; return canCalls<2;}; loadFunctions(ctx);
+  ctx.createRoomAndShowWaiting(); await tick();
+  ok(ctx.roomCode===null,'friend auth-loss catch clears roomCode');
+  ok(ctx.myPendingFriendRoomCode===null,'friend auth-loss catch clears pending friend');
+
+  // 6) exactly-once: activeMatch first.
+  db=makeDatabase(); ctx=baseContext(db); loadFunctions(ctx); ctx.createOnlineRoom(); await tick();
+  db._fire('users/tg_1/activeMatch','ABC123');
+  db._fire('rooms/ABC123/status','active');
+  ok(ctx.startOnlineGameCalls===1,'activeMatch+status race starts once');
+
+  // 7) exactly-once: status first.
+  db=makeDatabase(); ctx=baseContext(db); loadFunctions(ctx); ctx.createOnlineRoom(); await tick();
+  db._fire('rooms/ABC123/status','active');
+  db._fire('users/tg_1/activeMatch','ABC123');
+  ok(ctx.startOnlineGameCalls===1,'status+activeMatch race starts once');
+
+  // 8) false availability must not consume transition; later event recovers.
+  db=makeDatabase(); ctx=baseContext(db); loadFunctions(ctx); ctx.createOnlineRoom(); await tick();
+  let available=false; ctx.canUseFirebase=()=>available;
+  db._fire('rooms/ABC123/status','active');
+  ok(ctx.startOnlineGameCalls===0,'unavailable transition does not start game');
+  ok(ctx.myPendingOnlineRoom==='ABC123','unavailable transition does not consume pending room');
+  available=true; db._fire('rooms/ABC123/status','active');
+  ok(ctx.startOnlineGameCalls===1,'later event recovers transition');
+
+  // 9) preflight happens before room creation.
+  db=makeDatabase(); ctx=baseContext(db); loadFunctions(ctx); ctx.createOnlineRoom(); await tick();
+  const firstRemove=db._calls.findIndex(c=>c[0]==='remove'&&c[1]==='users/tg_1/activeMatch');
+  const roomSet=db._calls.findIndex(c=>c[0]==='set'&&c[1]==='rooms/ABC123');
+  ok(firstRemove>=0 && roomSet>firstRemove,'preflight clear precedes room set');
+
+  // 10) preflight reject leaves pre-existing sentinel state untouched.
+  db=makeDatabase({preflightReject:true}); ctx=baseContext(db);
+  ctx.roomCode='OLD'; ctx.myColor='dark'; ctx.isOnlineGame=true; ctx.isSpectator=true;
+  loadFunctions(ctx); ctx.createOnlineRoom(); await tick();
+  ok(ctx.roomCode==='OLD','preflight reject preserves roomCode');
+  ok(ctx.myColor==='dark','preflight reject preserves myColor');
+  ok(ctx.isOnlineGame===true,'preflight reject preserves isOnlineGame');
+  ok(ctx.isSpectator===true,'preflight reject preserves isSpectator');
+  ok(!db._calls.some(c=>c[0]==='set'&&c[1]==='rooms/ABC123'),'preflight reject prevents room set');
+  ok(ctx.showInfoModalCalls.includes('err_room_create_failed'),'preflight reject shows USER ERROR');
+
+  // 11) delayed stale activeMatch after new room creation is ignored; status fallback recovers.
+  db=makeDatabase(); ctx=baseContext(db); loadFunctions(ctx); ctx.createOnlineRoom(); await tick();
+  db._fire('users/tg_1/activeMatch','OLD999');
+  ok(ctx.startOnlineGameCalls===0,'stale activeMatch is ignored');
+  ok(ctx.roomCode==='ABC123','stale activeMatch cannot redirect roomCode');
+  db._fire('rooms/ABC123/status','active');
+  ok(ctx.startOnlineGameCalls===1,'status fallback starts current room');
+  ok(ctx.roomCode==='ABC123','status fallback keeps current room code');
+
+  // 12) retry uses stable captured ref even after global is nulled.
+  let removeAttempts=0;
+  const listeners={};
+  db={_listeners:listeners,_calls:[],_fire(path,v){const cb=listeners[path];if(cb)cb({val:()=>v});},ref(path){
+    return {set(){return Promise.resolve();},on(e,cb){listeners[path]=cb;},off(){delete listeners[path];},remove(){
+      if(path==='users/tg_1/activeMatch'){removeAttempts++; if(removeAttempts===2) return Promise.reject(new Error('first cleanup fails'));}
+      return Promise.resolve();
+    }};
+  }};
+  ctx=baseContext(db); loadFunctions(ctx); ctx.createOnlineRoom(); await tick();
+  db._fire('rooms/ABC123/status','active'); await tick();
+  ok(ctx.startOnlineGameCalls===1,'game starts independent of cleanup retry');
+  ok(removeAttempts>=3,'cleanup retry reuses real ref after first failure');
+
+  console.log(`room-create-error-handling: ${checks}/${checks}`);
+})().catch(e=>{console.error(e);process.exit(1);});
+
