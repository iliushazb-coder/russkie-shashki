# Зависимостей у проекта нет, но npm install может создать эту папку,
# если кто-то её случайно выполнит.
node_modules/
package-lock.json

# Служебные файлы операционных систем
.DS_Store
Thumbs.db
desktop.ini

# Редакторы
.vscode/
.idea/
*.swp
*~

# Логи и временные файлы
*.log
npm-debug.log*
*.tmp
*.bak

# Локальные архивы и черновики, которые не должны попасть в репозиторий
*.zip
