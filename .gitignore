# Зависимостей у проекта нет, но npm install может создать эту папку,
# если кто-то её случайно выполнит.
node_modules/
package-lock.json

# Служебные файлы операционных систем
.DS_Store
Thumbs.db
desktop.ini

# Редакторы
.vscode/
.idea/
*.swp
*~

# Логи и временные файлы
*.log
npm-debug.log*
*.tmp
*.bak

# Локальные архивы и черновики, которые не должны попасть в репозиторий
*.zip

# Секреты и локальная конфигурация с секретами.
# Никогда не коммитить: токен бота Telegram, приватный ключ сервисного
# аккаунта Firebase, токен Cloudflare API, GitHub PAT.
# worker/wrangler.toml сюда НЕ входит: конфигурация без секретных значений
# версионируется, секреты задаются через Cloudflare Secrets и .dev.vars.
.env
.env.*
.dev.vars
.dev.vars.*

# JSON сервисного аккаунта Firebase, включая имена с префиксом.
*service-account*.json
*service_account*.json
*[sS]erviceAccount*.json
*firebase-adminsdk*.json

# Приватные ключи и контейнеры сертификатов.
*.pem
*.key
*.p12
*.pfx
